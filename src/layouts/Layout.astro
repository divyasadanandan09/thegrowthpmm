---
import "../styles/global.css";
import ConsentBanner from "../components/ConsentBanner.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Growth PMM | Fractional Head of PMM",
  description = "The first Product Marketing leader you bring in before you hire a full-time one. I help post-PMF startups build the positioning, messaging, and GTM that turn early traction into scalable growth.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const SITE = (Astro.site?.href || "https://www.thegrowthpmm.com/").replace(/\/$/, "");
const LINKEDIN = "https://linkedin.com/in/divyasadanandan";
const KNOWS_ABOUT = [
  "Product Marketing",
  "Go-to-Market Strategy",
  "Positioning",
  "Messaging",
  "Growth Strategy",
  "Lifecycle and Retention Marketing",
  "Pricing and Packaging",
  "Marketing Experimentation",
  "AI in Product Marketing",
];

// Entity schema (Person + ProfessionalService) emitted on every page so answer
// engines and search can resolve "Divya Sadanandan" / "TheGrowthPMM" as one entity.
const entitySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}/#divya`,
      name: "Divya Sadanandan",
      alternateName: "TheGrowthPMM",
      url: SITE,
      image: `${SITE}/og-image.png`,
      jobTitle: "Fractional Head of Product Marketing",
      description:
        "The Product Marketing leader founders bring in before hiring a full-time one. I help post-PMF startups build the positioning, messaging, and GTM that turn early traction into scalable growth.",
      alumniOf: { "@type": "CollegeOrUniversity", name: "MICA, Ahmedabad" },
      knowsAbout: KNOWS_ABOUT,
      award: "Top 100 Product Marketing Influencer (Product Marketing Alliance, 2025)",
      sameAs: [LINKEDIN],
      worksFor: { "@id": `${SITE}/#thegrowthpmm` },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#thegrowthpmm`,
      name: "The Growth PMM",
      alternateName: "TheGrowthPMM",
      url: SITE,
      image: `${SITE}/og-image.png`,
      description:
        "Fractional Product Marketing leadership for post-PMF startups. The Product Marketing leader founders bring in before hiring a full-time one, building the positioning, messaging, and GTM that turn early traction into scalable growth.",
      founder: { "@id": `${SITE}/#divya` },
      email: "divya@thegrowthpmm.com",
      areaServed: ["India", "United States", "Worldwide"],
      serviceType: [
        "Fractional Head of Product Marketing",
        "Positioning and Messaging Audit",
        "Go-to-Market Strategy",
        "Growth Strategy",
        "AI Product Marketing",
      ],
      knowsAbout: KNOWS_ABOUT,
      sameAs: [LINKEDIN],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${SITE}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Growth PMM | Fractional Head of PMM" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-image.png`} />

    <title>{title}</title>

    <!-- Entity schema: Person + ProfessionalService -->
    <script type="application/ld+json" set:html={JSON.stringify(entitySchema)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Inter:wght@400;500;600;700;800&family=Caveat:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!--
      Analytics (Google Analytics 4), property "thegrowthpmm.com" under
      divya@thegrowthpmm.com. The measurement ID is public by design: it ships
      in the page source of every GA site, so there is nothing to hide here.

      Enhanced measurement is on in the GA console, so outbound clicks are
      tracked automatically. That is what captures clicks on the booking link,
      since calendar.app.google is a different origin.
    -->
    <!--
      Consent Mode v2 defaults MUST run before gtag.js loads, otherwise GA has
      already written cookies by the time consent is expressed and the banner
      is decoration. Hence this block sits above the tag, not below it.

      analytics_storage is denied for the EEA and UK only. Google enforces the
      region from the visitor's IP server side, so that holds even if the
      banner script never runs. Everywhere else defaults to granted, so most
      visitors are measured normally and see no banner.

      Denied does not mean invisible: GA still receives cookieless pings and
      models those sessions, so declining costs detail, not the visitor.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB'],
        wait_for_update: 500
      });
      gtag('consent', 'default', { analytics_storage: 'granted' });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V9TFZXSKBJ"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-V9TFZXSKBJ');

      // Booking clicks, the primary conversion.
      //
      // Enhanced measurement already logs these as generic outbound `click`
      // events, but those are awkward to use as a key event and lump every
      // external link together. This fires a named event instead, and records
      // WHICH call-to-action was clicked, so the hero, the floating corner
      // button and the closing band can be compared rather than pooled.
      //
      // Delegated on document, so new booking links anywhere on the site are
      // covered without touching them.
      document.addEventListener('click', function (e) {
        var a = e.target instanceof Element ? e.target.closest('a[href*="calendar.app.google"]') : null;
        if (!a) return;
        var where = a.closest('#nav-cta-corner') ? 'floating_corner'
                  : a.closest('#navbar') ? 'nav'
                  : a.closest('#mobile-menu') ? 'mobile_menu'
                  : a.closest('.audit-quiz') ? 'audit_results'
                  : a.closest('header') ? 'hero'
                  : 'in_page';
        gtag('event', 'book_call_click', {
          cta_location: where,
          page_path: location.pathname
        });
      }, true);
    </script>
  </head>
  <body class="bg-white text-stone-900 font-sans antialiased">
    <slot />
    <ConsentBanner />
  </body>
</html>

<style is:global>
  body {
    font-family: "Inter", sans-serif;
  }
</style>
