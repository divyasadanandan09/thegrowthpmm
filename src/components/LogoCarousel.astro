---
// Past-experience logo strip: a seamless marquee.
// The track renders the list twice; the -50% keyframe lands exactly on the
// second copy, so the loop has no visible seam or reset.
const logos = [
  { src: "/logos/fi-money.svg", alt: "Fi Money" },
  { src: "/logos/practo.png", alt: "Practo" },
  { src: "/logos/makemytrip.svg", alt: "MakeMyTrip" },
  { src: "/logos/raymond.png", alt: "Raymond" },
  { src: "/logos/tcs.png", alt: "TCS" },
  { src: "/logos/decathlon.svg", alt: "Decathlon" },
  { src: "/logos/ninjacart.png", alt: "Ninjacart" },
];
---

<section class="logo-carousel-wrap">
  <div class="carousel-container">
    <div class="carousel-track">
      {[...logos, ...logos].map((logo) => (
        <div class="carousel-item">
          <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.logo-carousel-wrap {
  background: var(--cream);
  border-top: 1px solid var(--warm-line);
  border-bottom: 1px solid var(--warm-line);
  padding: 32px 24px;
  overflow: hidden;
}

.carousel-container {
  max-width: 1240px;
  margin: 0 auto;
  overflow: hidden;
}

.carousel-track {
  display: flex;
  gap: 56px;
  width: max-content;
  animation: logo-scroll 20s linear infinite;
  will-change: transform;
}

/* Fixed row height: every logo sits in the same band, so the strip's
   top and bottom padding stay equal no matter each mark's aspect ratio. */
.carousel-item {
  flex: 0 0 auto;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Height is set here, not per-image, so no single logo can drift taller. */
.carousel-item img {
  display: block;
  height: 28px;
  width: auto;
  filter: grayscale(1);
  opacity: 0.75;
}

@keyframes logo-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.carousel-track:hover {
  animation-play-state: paused;
}

@media (max-width: 900px) {
  .logo-carousel-wrap { padding: 24px 16px; }
  .carousel-track { gap: 40px; animation-duration: 25s; }
}

@media (prefers-reduced-motion: reduce) {
  .carousel-track { animation: none; }
}
</style>
