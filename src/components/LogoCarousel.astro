---
// Logo Carousel — animated, auto-rotating strip with logos enlarged by 25%
// Sizes: Fi Money 27.5x27.5, Practo 100x27.5, MakeMyTrip 120x32.5, Raymond 81.25x27.5, TCS 96.25x27.5
---

<section class="logo-carousel-wrap" style="background:var(--cream);border-top:1px solid var(--warm-line);border-bottom:1px solid var(--warm-line);">
  <div style="max-width:1240px;margin:0 auto;padding:40px 24px;display:flex;align-items:center;gap:32px;justify-content:center;">

    <div class="carousel-container">
      <div class="carousel-track">
        <!-- Logos duplicated for seamless loop -->
        <div class="carousel-item">
          <img src="/logos/fi-money.svg" alt="Fi Money" loading="lazy" decoding="async" style="height:27.5px;width:27.5px;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/practo.png" alt="Practo" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/makemytrip.svg" alt="MakeMyTrip" loading="lazy" decoding="async" style="height:32.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/raymond.png" alt="Raymond" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/tcs.png" alt="TCS" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/decathlon.svg" alt="Decathlon" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/ninjacart.svg" alt="Ninjacart" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>

        <!-- Duplicated for seamless loop -->
        <div class="carousel-item">
          <img src="/logos/fi-money.svg" alt="Fi Money" loading="lazy" decoding="async" style="height:27.5px;width:27.5px;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/practo.png" alt="Practo" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/makemytrip.svg" alt="MakeMyTrip" loading="lazy" decoding="async" style="height:32.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/raymond.png" alt="Raymond" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/tcs.png" alt="TCS" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/decathlon.svg" alt="Decathlon" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
        <div class="carousel-item">
          <img src="/logos/ninjacart.svg" alt="Ninjacart" loading="lazy" decoding="async" style="height:27.5px;width:auto;filter:grayscale(1);opacity:0.75;" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.logo-carousel-wrap {
  overflow:hidden;
}

.carousel-container {
  flex:1;
  min-width:0;
  overflow:hidden;
}

.carousel-track {
  display:flex;
  gap:35px;
  animation:scroll 20s linear infinite;
  will-change:transform;
}

.carousel-item {
  flex:0 0 auto;
  display:flex;
  align-items:center;
  justify-content:center;
}

.carousel-item img {
  display:block;
}

@keyframes scroll {
  0% {
    transform:translateX(0);
  }
  100% {
    transform:translateX(-50%);
  }
}

/* Pause on hover */
.carousel-track:hover {
  animation-play-state:paused;
}

/* Mobile: slightly slower for readability */
@media (max-width:900px) {
  .carousel-track {
    animation:scroll 25s linear infinite;
  }

  .carousel-container {
    flex:1;
  }
}

/* Reduced motion preference */
@media (prefers-reduced-motion:reduce) {
  .carousel-track {
    animation:none;
    transform:translateX(0);
  }
}
</style>
