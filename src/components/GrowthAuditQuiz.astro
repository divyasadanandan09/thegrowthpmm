---
// Growth Audit — the 12-question funnel diagnostic, embedded.
//
// Questions are the exact set from the Google Form this replaces
// (forms.gle/HTwdNSTiyyXQYsxb7): 3 per stage, 3 options each.
//
// SCORING IS A RECONSTRUCTION, NOT A COPY. The form's own weights were not
// recoverable. What is known, from a sent audit email, is the stage maxima:
// Acquisition 14, Activation 12, Conversion 12, Retention 12, total 50. The
// weights below are the simplest set that hits those maxima AND reproduces
// that email's 9/7/7/6 = 29 exactly. Confirm against the form's key before
// treating any individual score as authoritative.
//
// Layout: one stage per screen. Within a screen the three questions are a
// stack, one open at a time, answered ones collapsing to a summary line.

const BOOKING = "https://calendar.app.google/LXLo1623kmwa7NWr6";

const stages = [
  {
    id: "acquisition",
    name: "Acquisition",
    max: 14,
    blurb: "How you bring people in.",
    questions: [
      {
        q: "How many channels are you actively running right now?",
        options: [
          { label: "1 to 2", value: 5 },
          { label: "3 to 4", value: 3 },
          { label: "5 or more", value: 1 },
        ],
      },
      {
        q: "When did you last kill or pause an underperforming channel?",
        options: [
          { label: "Within the last quarter", value: 5 },
          { label: "Over 6 months ago", value: 3 },
          { label: "Never, we just keep adding", value: 1 },
        ],
      },
      {
        q: "Do you know your CAC by channel, or only blended CAC?",
        options: [
          { label: "By channel", value: 4 },
          { label: "Only blended", value: 2 },
          { label: "Not tracked well", value: 1 },
        ],
      },
    ],
  },
  {
    id: "activation",
    name: "Activation",
    max: 12,
    blurb: "How fast they reach value.",
    questions: [
      {
        q: "Do you know your time-to-first-value for new users or customers?",
        options: [
          { label: "Yes, actively tracked", value: 4 },
          { label: "Rough idea", value: 2 },
          { label: "No idea", value: 1 },
        ],
      },
      {
        q: "Is your activation ‘aha moment’ clearly defined and documented, or understood informally?",
        options: [
          { label: "Defined and documented", value: 4 },
          { label: "Understood informally, not written down", value: 2 },
          { label: "Not really defined", value: 1 },
        ],
      },
      {
        q: "What share of signups or trials reach activation?",
        options: [
          { label: "We track this number", value: 4 },
          { label: "We estimate it", value: 2 },
          { label: "We do not measure this", value: 1 },
        ],
      },
    ],
  },
  {
    id: "conversion",
    name: "Conversion",
    max: 12,
    blurb: "How they become paying customers.",
    questions: [
      {
        q: "Can you name your number one drop-off point in the funnel right now?",
        options: [
          { label: "Yes, specifically", value: 4 },
          { label: "I have a guess", value: 2 },
          { label: "No", value: 1 },
        ],
      },
      {
        q: "Do you have documented reasons for your last 5 lost deals?",
        options: [
          { label: "Yes", value: 4 },
          { label: "Some anecdotal sense", value: 2 },
          { label: "No", value: 1 },
        ],
      },
      {
        q: "Who owns fixing conversion drop-off?",
        options: [
          { label: "Clear owner", value: 4 },
          { label: "Shared or unclear", value: 2 },
          { label: "No owner", value: 1 },
        ],
      },
    ],
  },
  {
    id: "retention",
    name: "Retention",
    max: 12,
    blurb: "How they stay, and grow.",
    questions: [
      {
        q: "Is retention owned by a specific person or team, or does it fall between Sales and CS?",
        options: [
          { label: "Clear owner", value: 4 },
          { label: "Falls between teams", value: 2 },
          { label: "No real ownership", value: 1 },
        ],
      },
      {
        q: "Do you know your expansion revenue as a share of total revenue?",
        options: [
          { label: "Yes, tracked", value: 4 },
          { label: "Rough estimate", value: 2 },
          { label: "Not tracked", value: 1 },
        ],
      },
      {
        q: "When a customer churns, do you know why more than half the time?",
        options: [
          { label: "Yes, documented", value: 4 },
          { label: "Sometimes", value: 2 },
          { label: "Rarely", value: 1 },
        ],
      },
    ],
  },
];

// Questions are numbered continuously across stages (1 to 12), not restarted
// per stage, so the founder can see how far through the whole audit they are.
const startNumber = stages.map((_, i) =>
  stages.slice(0, i).reduce((n, s) => n + s.questions.length, 1)
);
---

<div class="audit-quiz">
  <!-- STAGE SCREENS -->
  <div id="quizForm">
    <div class="quiz-progress" aria-hidden="true"><div id="progressBar"></div></div>
    <p class="quiz-step" id="stepLabel">Step 1 of 5</p>

    {stages.map((stage, si) => (
      <section class="stage" data-stage={si} hidden={si !== 0} aria-label={stage.name}>
        <h3 class="stage-name">{stage.name}</h3>
        <p class="stage-blurb">{stage.blurb}</p>

        <div class="stack">
          {stage.questions.map((item, qi) => (
            <div class="card" data-card={qi} data-open={qi === 0 ? "true" : "false"}>
              <button type="button" class="card-head" aria-expanded={qi === 0 ? "true" : "false"}>
                <span class="card-num">{startNumber[si] + qi}</span>
                <span class="card-q">{item.q}</span>
                <span class="card-answer" hidden></span>
              </button>
              <div class="card-body">
                {item.options.map((opt) => (
                  <label class="opt">
                    <input type="radio" name={`${stage.id}-${qi}`} value={opt.value} data-label={opt.label} />
                    <span>{opt.label}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- EMAIL SCREEN -->
    <section class="stage" data-stage="4" hidden aria-label="Your work email">
      <h3 class="stage-name">Where should the audit go?</h3>
      <p class="stage-blurb">Work email only. The audit reads on your company, so a personal inbox will not do.</p>
      <div class="stack">
        <div class="card" data-open="true">
          <div class="card-body" style="padding-top:18px;">
            <label class="field-label" for="workEmail">Work email</label>
            <input type="email" id="workEmail" placeholder="you@yourcompany.com" autocomplete="email" spellcheck="false" />
            <p class="field-error" id="emailError" hidden></p>
          </div>
        </div>
      </div>
    </section>

    <div class="quiz-nav">
      <button type="button" id="backBtn" class="btn-ghost" hidden>Back</button>
      <button type="button" id="nextBtn" class="btn-navy" disabled>Next</button>
    </div>
  </div>

  <!-- RESULTS -->
  <div id="results" hidden>
    <p class="res-eyebrow">Your Growth Audit</p>
    <h3 class="res-score"><span id="totalScore">0</span><span class="res-out">/50</span></h3>
    <p class="res-verdict" id="verdict"></p>

    <!-- Rendered statically, filled by JS. Astro scopes <style> to markup that
         exists at build time, so innerHTML-injected rows would come out unstyled. -->
    <div class="bars" id="bars">
      {["Acquisition", "Activation", "Conversion", "Retention"].map((name) => (
        <div class="bar-row" data-row={name}>
          <span class="bar-name">{name}</span>
          <span class="bar-track"><span class="bar-fill"></span></span>
          <span class="bar-meta"><span class="bar-val"></span><span class="bar-tag"></span></span>
        </div>
      ))}
    </div>

    <div class="finding">
      <p class="finding-label">Your biggest gap</p>
      <h4 class="finding-title" id="gapTitle"></h4>
      <p class="finding-body" id="gapRead"></p>

      <div class="finding-split">
        <div>
          <p class="finding-label">Likely root cause</p>
          <p class="finding-body" id="gapCause"></p>
        </div>
        <div>
          <p class="finding-label">Your first move</p>
          <p class="finding-body" id="gapMove"></p>
        </div>
      </div>

      <p class="finding-next" id="gapNext"></p>
    </div>

    <div class="res-cta">
      <p class="res-cta-line">Every one of these is fixable. The fastest way through is 20 minutes on a call.</p>
      <a href={BOOKING} target="_blank" rel="noopener" class="btn-navy btn-lg">Book your free consultation</a>
      <p class="res-note" id="resNote"></p>
    </div>
  </div>
</div>

<style>
.audit-quiz {
  max-width: 660px;
  margin: 44px auto 0;
  background: #fff;
  border: 1px solid var(--warm-line);
  border-radius: 18px;
  padding: 40px;
  text-align: left;
}

/* progress */
.quiz-progress { height: 4px; background: var(--cream); border-radius: 99px; overflow: hidden; }
.quiz-progress > div { height: 100%; width: 20%; background: var(--navy); transition: width .3s ease; }
.quiz-step { font-size: 12px; font-weight: 700; color: var(--ink-mute); margin: 14px 0 0; }

.stage-name { font-size: 26px; font-weight: 800; letter-spacing: -.5px; margin: 6px 0 0; color: var(--ink-deep); }
.stage-blurb { font-size: 15px; color: var(--ink-mute); margin: 6px 0 0; }

/* Stacked-paper cards: collapsed sheets tuck under the open one. */
.stack { margin-top: 22px; display: flex; flex-direction: column; gap: 10px; }

.card {
  border: 1px solid var(--warm-line);
  border-radius: 12px;
  background: #fff;
  transition: box-shadow .2s ease, transform .2s ease, border-color .2s ease;
}
.card[data-open="true"] {
  border-color: var(--ink-deep);
  box-shadow: 0 10px 26px rgba(22,24,15,.10);
}
.card[data-open="false"] { background: #fcfcfa; }
.card[data-open="false"]:hover { transform: translateY(-1px); }

.card-head {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  background: none;
  border: 0;
  font: inherit;
  text-align: left;
  cursor: pointer;
  color: var(--ink-deep);
}
/* Pill, not a fixed circle, so two-digit numbers (10 to 12) still fit. */
.card-num {
  flex: none;
  min-width: 24px; height: 24px;
  padding: 0 6px; box-sizing: border-box;
  border-radius: 99px;
  display: grid; place-items: center;
  font-size: 12px; font-weight: 700;
  background: var(--cream); color: var(--ink-mute);
}
.card[data-open="true"] .card-num { background: var(--navy); color: var(--ink-deep); }
.card[data-answered="true"] .card-num { background: var(--navy); color: var(--ink-deep); }

.card-q { flex: 1; font-size: 15px; font-weight: 600; line-height: 1.4; }
.card[data-open="false"] .card-q {
  font-weight: 500;
  color: var(--ink-mute);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.card-answer { flex: none; font-size: 13px; font-weight: 700; color: var(--ink-deep); }

.card-body { display: none; padding: 0 16px 16px 50px; }
.card[data-open="true"] .card-body { display: block; }

.opt {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 14px; margin-top: 8px;
  border: 1px solid var(--warm-line); border-radius: 9px;
  cursor: pointer; font-size: 15px;
  transition: border-color .15s ease, background .15s ease;
}
.opt:hover { border-color: var(--ink-deep); background: var(--cream); }
.opt input { accent-color: var(--ink-deep); cursor: pointer; }
.opt:has(input:checked) { border-color: var(--ink-deep); background: var(--cream); font-weight: 600; }

.field-label { display: block; font-size: 12px; font-weight: 700; color: var(--ink-mute); margin-bottom: 8px; }
#workEmail {
  width: 100%; box-sizing: border-box;
  padding: 13px 15px; font: inherit; font-size: 16px;
  border: 1px solid var(--warm-line); border-radius: 9px;
}
#workEmail:focus { outline: none; border-color: var(--ink-deep); }
#workEmail[aria-invalid="true"] { border-color: #cc4117; }
.field-error { font-size: 13px; color: #cc4117; margin: 8px 0 0; font-weight: 600; }

.quiz-nav { display: flex; gap: 10px; justify-content: flex-end; margin-top: 26px; }
.btn-ghost {
  padding: 12px 22px; border: 1px solid var(--warm-line);
  border-radius: 99px; background: #fff; cursor: pointer;
  font: inherit; font-weight: 600; color: var(--ink-deep);
}
.quiz-nav .btn-navy { padding: 12px 30px; cursor: pointer; border: 0; font: inherit; font-weight: 700; }
.quiz-nav .btn-navy:disabled { opacity: .45; cursor: not-allowed; }

/* ---------- results ---------- */
.res-eyebrow { font-size: 12px; font-weight: 700; color: var(--ink-mute); margin: 0; }
.res-score {
  font-size: 60px; font-weight: 800; letter-spacing: -2px;
  margin: 2px 0 0; color: var(--ink-deep); line-height: 1;
}
.res-out { font-size: 26px; color: var(--ink-mute); letter-spacing: -.5px; }
.res-verdict { font-size: 17px; line-height: 1.55; color: var(--ink-deep); margin: 12px 0 0; font-weight: 600; }

.bars { margin: 30px 0 0; display: flex; flex-direction: column; gap: 16px; }
.bar-row { display: grid; grid-template-columns: 108px 1fr auto; align-items: center; gap: 14px; }
.bar-name { font-size: 14px; font-weight: 700; color: var(--ink-deep); }
/* Both are spans, so they must be blockified or width/height are ignored. */
.bar-track { display: block; height: 12px; border-radius: 99px; background: var(--cream); overflow: hidden; }
.bar-fill { display: block; height: 100%; width: 0; border-radius: 99px; transition: width .5s ease; }
/* Lime only ever as a fill, never as text on light. Coral marks drop-off. */
.bar-fill.healthy { background: var(--navy); }
.bar-fill.risk    { background: #f0b429; }
.bar-fill.leaking { background: #ec6a43; }
.bar-meta { font-size: 13px; font-weight: 700; color: var(--ink-deep); white-space: nowrap; }
.bar-tag { display: block; font-size: 11px; font-weight: 700; color: var(--ink-mute); }

.finding {
  margin: 32px 0 0; padding: 26px;
  background: var(--cream); border-radius: 14px;
  border-left: 4px solid var(--navy);
}
.finding-label { font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; color: var(--ink-mute); margin: 0; }
.finding-title { font-size: 21px; font-weight: 800; color: var(--ink-deep); margin: 8px 0 0; letter-spacing: -.3px; }
.finding-body { font-size: 15px; line-height: 1.6; color: var(--ink-deep); margin: 8px 0 0; }
.finding-split { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 22px; }
.finding-next { font-size: 14px; line-height: 1.55; color: var(--ink-mute); margin: 22px 0 0; padding-top: 16px; border-top: 1px solid var(--warm-line); }

.res-cta { margin: 34px 0 0; text-align: center; }
.res-cta-line { font-size: 16px; line-height: 1.55; color: var(--ink-deep); margin: 0 0 18px; font-weight: 600; }
.btn-lg { display: inline-block; font-size: 17px; padding: 16px 34px; box-shadow: 0 6px 22px rgba(22,24,15,.22); }
.res-note { font-size: 13px; color: var(--ink-mute); margin: 14px 0 0; }

@media (max-width: 900px) {
  .audit-quiz { padding: 26px 20px; border-radius: 14px; }
  .res-score { font-size: 48px; }
  .card-body { padding-left: 16px; }
  .bar-row { grid-template-columns: 92px 1fr auto; gap: 10px; }
  .finding-split { grid-template-columns: 1fr; gap: 18px; }
}
</style>

<script>
  // Single source of truth, shared with the emailed audit. The Apps Script
  // gets the same JSON injected by scripts/sync-audit-copy.mjs, and the build
  // fails if the two drift, so the page and the email cannot disagree.
  import copy from "../content/audit-copy.json";

  const MAXES: Record<string, number> = {
    Acquisition: 14, Activation: 12, Conversion: 12, Retention: 12,
  };

  const DIAG = copy.stages;
  const VERDICTS = copy.verdicts;
  const FREE_MAIL = copy.freeMailDomains;

  const root = document.querySelector(".audit-quiz") as HTMLElement;
  if (root) {
    const screens = Array.from(root.querySelectorAll<HTMLElement>(".stage"));
    const nextBtn = root.querySelector("#nextBtn") as HTMLButtonElement;
    const backBtn = root.querySelector("#backBtn") as HTMLButtonElement;
    const bar = root.querySelector("#progressBar") as HTMLElement;
    const stepLabel = root.querySelector("#stepLabel") as HTMLElement;
    const form = root.querySelector("#quizForm") as HTMLElement;
    const results = root.querySelector("#results") as HTMLElement;
    const emailInput = root.querySelector("#workEmail") as HTMLInputElement;
    const emailError = root.querySelector("#emailError") as HTMLElement;

    let current = 0;

    const isEmailScreen = () => current === screens.length - 1;

    function openCard(stage: HTMLElement, index: number) {
      stage.querySelectorAll<HTMLElement>(".card").forEach((card, i) => {
        const open = i === index;
        card.dataset.open = String(open);
        card.querySelector(".card-head")?.setAttribute("aria-expanded", String(open));
      });
    }

    function validateEmail(): string | null {
      const value = (emailInput?.value || "").trim();
      if (!value) return "Enter your work email.";
      // Deliberately permissive on shape, strict on domain type.
      if (!/^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(value)) return "That does not look like a valid email.";
      const domain = value.split("@")[1].toLowerCase();
      if (FREE_MAIL.includes(domain)) return "Please use your work email, not a personal one.";
      return null;
    }

    function refreshNext() {
      if (isEmailScreen()) {
        nextBtn.disabled = validateEmail() !== null;
        nextBtn.textContent = "Get my audit";
        return;
      }
      const stage = screens[current];
      const groups = new Set(
        Array.from(stage.querySelectorAll<HTMLInputElement>("input[type=radio]")).map((i) => i.name)
      );
      const answered = Array.from(groups).every((n) => stage.querySelector(`input[name="${n}"]:checked`));
      nextBtn.disabled = !answered;
      nextBtn.textContent = "Next";
    }

    /**
     * `scroll` must stay false for the initial render. This runs on every page
     * that embeds the quiz, so scrolling here yanks the visitor from the hero
     * down to the quiz the moment the page loads. It also moves the viewport
     * during load, which stops Lighthouse resolving an LCP element at all
     * (NO_LCP). Only scroll when the visitor actually changed step.
     */
    function show(index: number, scroll = true) {
      current = index;
      screens.forEach((s, i) => (s.hidden = i !== index));
      bar.style.width = `${((index + 1) / screens.length) * 100}%`;
      stepLabel.textContent = `Step ${index + 1} of ${screens.length}`;
      backBtn.hidden = index === 0;
      refreshNext();
      if (scroll) root.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    // GA4. Safe if the tag is blocked or consent was declined: gtag is simply
    // undefined and these become no-ops.
    const track = (name: string, params: Record<string, unknown> = {}) =>
      (window as any).gtag?.("event", name, params);

    let started = false;

    // Answering collapses the card and opens the next unanswered one.
    root.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type === "radio") {
        // Fires once, on the first answer. Paired with the per-stage events
        // below this is what makes quiz drop-off legible: how many begin
        // versus how many reach the email step.
        if (!started) { started = true; track("audit_start"); }

        const card = input.closest(".card") as HTMLElement;
        const stage = input.closest(".stage") as HTMLElement;
        card.dataset.answered = "true";
        const tag = card.querySelector(".card-answer") as HTMLElement;
        tag.textContent = input.dataset.label || "";
        tag.hidden = false;

        const cards = Array.from(stage.querySelectorAll<HTMLElement>(".card"));
        const nextUnanswered = cards.findIndex((c) => c.dataset.answered !== "true");
        if (nextUnanswered > -1) openCard(stage, nextUnanswered);
        else openCard(stage, -1);
      }
      refreshNext();
    });

    // Let people reopen any card in the stack.
    root.addEventListener("click", (e) => {
      const head = (e.target as HTMLElement).closest(".card-head");
      if (!head) return;
      const stage = head.closest(".stage") as HTMLElement;
      const cards = Array.from(stage.querySelectorAll<HTMLElement>(".card"));
      const card = head.closest(".card") as HTMLElement;
      openCard(stage, card.dataset.open === "true" ? -1 : cards.indexOf(card));
    });

    // Surface the reason as they type. A disabled button with no explanation
    // reads as a broken form, especially to anyone entering a personal address.
    emailInput?.addEventListener("input", () => {
      const value = emailInput.value.trim();
      const err = validateEmail();
      const worthWarning = value.includes("@") && value.split("@")[1]?.includes(".");
      if (err && worthWarning) {
        emailError.textContent = err;
        emailError.hidden = false;
        emailInput.setAttribute("aria-invalid", "true");
      } else {
        emailError.hidden = true;
        emailInput.setAttribute("aria-invalid", "false");
      }
      refreshNext();
    });

    backBtn.addEventListener("click", () => show(Math.max(0, current - 1)));

    nextBtn.addEventListener("click", () => {
      if (!isEmailScreen()) {
        // One event per completed stage, so drop-off is visible per funnel
        // stage rather than only start versus finish.
        track("audit_stage_complete", { stage: current + 1 });
        show(current + 1);
        return;
      }
      const err = validateEmail();
      if (err) {
        emailError.textContent = err;
        emailError.hidden = false;
        emailInput.setAttribute("aria-invalid", "true");
        return;
      }
      finish();
    });

    function finish() {
      const scores = screens.slice(0, 4).map((stage) => {
        const name = (stage.querySelector(".stage-name") as HTMLElement).textContent!.trim();
        const picked = Array.from(stage.querySelectorAll<HTMLInputElement>("input[type=radio]:checked"));
        const score = picked.reduce((sum, i) => sum + Number(i.value), 0);
        return { name, score, max: MAXES[name] };
      });

      const total = scores.reduce((s, x) => s + x.score, 0);
      (root.querySelector("#totalScore") as HTMLElement).textContent = String(total);

      const ranked = [...scores].sort((a, b) => a.score / a.max - b.score / b.max);
      const worst = ranked[0];
      const second = ranked[1];

      (root.querySelector("#verdict") as HTMLElement).textContent =
        total >= 40 ? VERDICTS.strong : total >= 28 ? VERDICTS.mixed : VERDICTS.weak;

      scores.forEach(({ name, score, max }) => {
        const row = root.querySelector<HTMLElement>(`.bar-row[data-row="${name}"]`);
        if (!row) return;
        const pct = Math.round((score / max) * 100);
        const state = pct >= 75 ? "healthy" : pct >= 50 ? "risk" : "leaking";
        const fill = row.querySelector<HTMLElement>(".bar-fill")!;
        fill.classList.remove("healthy", "risk", "leaking");
        fill.classList.add(state);
        fill.style.width = `${pct}%`;
        row.querySelector<HTMLElement>(".bar-val")!.textContent = `${score}/${max}`;
        row.querySelector<HTMLElement>(".bar-tag")!.textContent =
          state === "healthy" ? "Healthy" : state === "risk" ? "At risk" : "Leaking";
      });

      const d = DIAG[worst.name];
      (root.querySelector("#gapTitle") as HTMLElement).textContent = `${worst.name}, at ${worst.score} out of ${worst.max}`;
      (root.querySelector("#gapRead") as HTMLElement).textContent = d.read;
      (root.querySelector("#gapCause") as HTMLElement).textContent = d.cause;
      (root.querySelector("#gapMove") as HTMLElement).textContent = d.move;
      (root.querySelector("#gapNext") as HTMLElement).textContent =
        `Second priority: ${second.name}, at ${second.score} out of ${second.max}. Fix ${worst.name} first. Moving it usually lifts ${second.name} on its own.`;

      (root.querySelector("#resNote") as HTMLElement).textContent =
        `A full written version is on its way to ${emailInput.value.trim()}.`;

      send({
        email: emailInput.value.trim(),
        total,
        ...Object.fromEntries(scores.map((s) => [s.name.toLowerCase(), s.score])),
        biggestGap: worst.name,
      });

      // generate_lead is GA4's recommended name for exactly this, so it slots
      // into Google's lead-gen reporting rather than sitting off to one side.
      // No email is sent to GA: that would be personal data leaving to a
      // third party, and the score is what is useful for analysis anyway.
      track("generate_lead", {
        audit_score: total,
        biggest_gap: worst.name,
      });

      form.hidden = true;
      results.hidden = false;
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    async function send(payload: Record<string, unknown>) {
      const endpoint = import.meta.env.PUBLIC_AUDIT_ENDPOINT;
      if (!endpoint) return;
      try {
        await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload),
        });
      } catch {
        // Results are already on screen; a failed post must not block them.
      }
    }

    show(0, false);
  }
</script>
