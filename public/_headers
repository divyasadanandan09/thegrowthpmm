/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro fingerprints these filenames with a content hash, so a changed file is
# a changed URL and this can never serve a stale asset. Lighthouse flagged the
# default cache lifetime as too short. 2026-08-05.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, so a year is only safe because the filenames are stable and the
# contents are frozen font binaries. Rename the file if you ever swap a face.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=604800

/divya.jpg
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800
